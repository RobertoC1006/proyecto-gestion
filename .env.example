# Configuración de desarrollo. No contiene credenciales reales.
# Roberto entrega DATABASE_URL por un medio privado: rol de API, nunca administrador.
# Proyecto CampusITSM, esquema campusitsm, pooler sesión 5432, TLS estricto con CA incluida.
DATABASE_URL=
# Solo para una ejecución manual de migrate. Preferir un archivo privado separado.
MIGRATION_DATABASE_URL=
# PostgreSQL opcional para pruebas aisladas; no se inicia en el modo compartido.
# Cambiar antes del primer arranque si se desea una contraseña local diferente.
# Usar letras/números/guion/guion bajo para no requerir codificación URL.
POSTGRES_USER=campusitsm
POSTGRES_PASSWORD=campusitsm_local_only
POSTGRES_DB=campusitsm
WEB_PORT=8080

# Auth alojado. No copiar claves secret/service_role: solo publishable (o anon antigua).
# Base de negocio y Auth están en Supabase; estas variables solo llegan a NestJS.
APP_ORIGIN=http://localhost:8080
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 32 bytes aleatorios en base64; scripts/prepare-auth.ps1 lo genera en .env sin mostrarlo.
AUTH_ENCRYPTION_KEY=
AUTH_INSTITUTION_CODE=UPT-DEMO
# UUID de una cuenta real ya registrada/confirmada y con primer login local.
# Solo para el comando manual de primer administrador; no se usa al arrancar.
BOOTSTRAP_USER_ID=
