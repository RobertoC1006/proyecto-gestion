{
  "name": "campusitsm-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node --watch --require ts-node/register src/main.ts",
    "prisma:generate": "prisma generate",
    "db:deploy": "node prisma/deploy.cjs",
    "db:seed": "node prisma/seed.cjs",
    "test:academic": "node --test test/academic.test.cjs",
    "test:auth": "node --test --test-concurrency=1 test/auth.test.cjs test/auth.provider.test.cjs test/role-permissions.test.cjs",
    "api:export": "node prisma/export-openapi.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "2.119.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/node": "22.15.30",
    "prisma": "6.19.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "multer": "2.5.0",
    "@prisma/config": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.21.4"
    }
  }
}
