{
  "name": "campusitsm-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node --watch --require ts-node/register src/main.ts",
    "prisma:generate": "prisma generate",
    "db:deploy": "node prisma/deploy.cjs",
    "db:seed": "node prisma/seed.cjs",
    "test:academic": "node --test test/academic.test.cjs",
    "test:auth": "node --test --test-concurrency=1 test/auth.test.cjs test/auth.provider.test.cjs test/role-permissions.test.cjs",
    "api:export": "node prisma/export-openapi.cjs",
    "test:users": "node --test test/users.test.cjs",
    "test:certificates": "npm run build && node --test test/certificates.test.cjs test/certificates.upload.test.cjs",
    "test:certificates:http": "npm run build && node --test test/certificates.http.test.cjs",
    "test:privacy": "node --test test/privacy.test.cjs",
    "test:reports": "npm run build && node --test test/reports.test.cjs",
    "test:reports:http": "npm run build && node --test test/reports.http.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "2.119.0",
    "express": "5.2.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/express": "^5.0.6",
    "@types/node": "22.15.30",
    "@types/qrcode": "^1.5.6",
    "prisma": "6.19.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "multer": "2.5.0",
    "@prisma/config": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.21.4"
    }
  }
}
