generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Base de instalación; identidad y tickets se coordinan antes de añadir sus tablas.
model Institution {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique @db.VarChar(40)
  name      String        @db.VarChar(160)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  teams     SupportTeam[]
  courses   AcademicCourse[]
  events    AcademicEvent[]
  users     AppUser[]
}

enum AcademicEventType {
  examen
  entrega
  matricula
}

enum AcademicScope {
  institution
  course
  section
}

model AcademicCourse {
  id            String @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  code          String @db.VarChar(40)
  name          String @db.VarChar(160)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  sections      AcademicSection[]
  events        AcademicEvent[]

  @@unique([institutionId, code])
  @@unique([institutionId, id])
}

model AcademicSection {
  id            String @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  courseId      String @db.Uuid
  code          String @db.VarChar(40)
  name          String @db.VarChar(160)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  course        AcademicCourse @relation(fields: [institutionId, courseId], references: [institutionId, id], onDelete: Restrict)
  memberships   AcademicMembership[]
  events        AcademicEvent[]

  @@unique([courseId, code])
  @@unique([institutionId, courseId, id])
}

model AcademicMembership {
  institutionId String @db.Uuid
  courseId      String @db.Uuid
  sectionId     String @db.Uuid
  // Referencia opaca al módulo de identidad; no es una tabla alternativa de usuarios.
  subjectId     String @db.Uuid
  section       AcademicSection @relation(fields: [institutionId, courseId, sectionId], references: [institutionId, courseId, id], onDelete: Restrict)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@id([sectionId, subjectId])
  @@index([institutionId, subjectId])
}

model AcademicEvent {
  id            String @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  title         String @db.VarChar(160)
  type          AcademicEventType
  scope         AcademicScope
  courseId      String? @db.Uuid
  sectionId     String? @db.Uuid
  source        String @default("manual") @db.VarChar(20)
  startsAt      DateTime @db.Timestamptz(3)
  endsAt        DateTime @db.Timestamptz(3)
  version       Int @default(1)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  course        AcademicCourse? @relation(fields: [institutionId, courseId], references: [institutionId, id], onDelete: Restrict)
  section       AcademicSection? @relation(fields: [institutionId, courseId, sectionId], references: [institutionId, courseId, id], onDelete: Restrict)

  @@index([institutionId, startsAt, endsAt])
}

model AcademicChange {
  id            String @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  actorId       String @db.Uuid
  entityType    String @db.VarChar(40)
  entityId      String @db.Uuid
  action        String @db.VarChar(20)
  reason        String @db.VarChar(500)
  source        String @default("manual") @db.VarChar(20)
  before        Json?
  after         Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([institutionId, createdAt])
}

model SupportTeam {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @db.Uuid
  code          String      @db.VarChar(40)
  name          String      @db.VarChar(160)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  users         AppUser[]

  @@unique([institutionId, code])
  @@unique([institutionId, id])
}

enum CampusRole {
  estudiante
  docente
  ti_agente
  ti_supervisor
  administrador
}

model AppUser {
  // UUID canónico = subject de Supabase. Las credenciales permanecen en Auth.
  id            String @id @db.Uuid
  institutionId String @db.Uuid
  email         String @db.VarChar(254)
  displayName   String @db.VarChar(120)
  role          CampusRole @default(estudiante)
  active        Boolean @default(true)
  teamId        String? @db.Uuid
  accessVersion Int @default(1)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  team          SupportTeam? @relation(fields: [institutionId, teamId], references: [institutionId, id], onDelete: Restrict)
  sessions      AuthSession[]

  @@unique([institutionId, id])
  @@index([institutionId, role, active])
}

model AuthSession {
  // Solo la huella de la cookie opaca; tokens cifrados con AES-256-GCM.
  id            String @id @db.VarChar(64)
  userId        String @db.Uuid
  accessVersion Int
  tokens        String @db.Text
  tokenExpiresAt DateTime @db.Timestamptz(3)
  expiresAt     DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  user          AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthThrottle {
  id        String @id @db.VarChar(64)
  attempts  Int @default(1)
  expiresAt DateTime @db.Timestamptz(3)
}

model AuthFlow {
  id        String @id @db.VarChar(64)
  purpose   String @db.VarChar(20)
  secret    String @db.Text
  expiresAt DateTime @db.Timestamptz(3)
}

// Cambios de autorización atómicos para entrega futura a auditoría de Jasmine.
model IdentityChange {
  id            String @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  actorId       String @db.Uuid
  subjectId     String @db.Uuid
  reason        String @db.VarChar(500)
  before        Json
  after         Json
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  @@index([institutionId, createdAt])
}
