generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Base de instalaciÃ³n; los tickets de Johan reutilizan identidad y calendario.
model Institution {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique @db.VarChar(40)
  name      String        @db.VarChar(160)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  teams     SupportTeam[]
  courses   AcademicCourse[]
  events    AcademicEvent[]
  users     AppUser[]
  roleAccess RoleAccess[]
  rolePermissionChanges RolePermissionChange[]
}

enum AcademicEventType {
  examen
  entrega
  matricula
}

enum AcademicScope {
  institution
  course
  section
}

model AcademicCourse {
  id            String @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  code          String @db.VarChar(40)
  name          String @db.VarChar(160)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  sections      AcademicSection[]
  events        AcademicEvent[]
  tickets       Ticket[]

  @@unique([institutionId, code])
  @@unique([institutionId, id])
}

model AcademicSection {
  id            String @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  courseId      String @db.Uuid
  code          String @db.VarChar(40)
  name          String @db.VarChar(160)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  course        AcademicCourse @relation(fields: [institutionId, courseId], references: [institutionId, id], onDelete: Restrict)
  memberships   AcademicMembership[]
  events        AcademicEvent[]
  tickets       Ticket[]

  @@unique([courseId, code])
  @@unique([institutionId, courseId, id])
}

model AcademicMembership {
  institutionId String @db.Uuid
  courseId      String @db.Uuid
  sectionId     String @db.Uuid
  // Referencia opaca al mÃ³dulo de identidad; no es una tabla alternativa de usuarios.
  subjectId     String @db.Uuid
  section       AcademicSection @relation(fields: [institutionId, courseId, sectionId], references: [institutionId, courseId, id], onDelete: Restrict)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@id([sectionId, subjectId])
  @@index([institutionId, subjectId])
}

model AcademicEvent {
  id            String @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  title         String @db.VarChar(160)
  type          AcademicEventType
  scope         AcademicScope
  courseId      String? @db.Uuid
  sectionId     String? @db.Uuid
  source        String @default("manual") @db.VarChar(20)
  startsAt      DateTime @db.Timestamptz(3)
  endsAt        DateTime @db.Timestamptz(3)
  createdById   String? @db.Uuid
  version       Int @default(1)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  course        AcademicCourse? @relation(fields: [institutionId, courseId], references: [institutionId, id], onDelete: Restrict)
  section       AcademicSection? @relation(fields: [institutionId, courseId, sectionId], references: [institutionId, courseId, id], onDelete: Restrict)

  @@index([institutionId, startsAt, endsAt])
}

model AcademicChange {
  id            String @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  actorId       String @db.Uuid
  entityType    String @db.VarChar(40)
  entityId      String @db.Uuid
  action        String @db.VarChar(20)
  reason        String @db.VarChar(500)
  source        String @default("manual") @db.VarChar(20)
  before        Json?
  after         Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([institutionId, createdAt])
}

model SupportTeam {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @db.Uuid
  code          String      @db.VarChar(40)
  name          String      @db.VarChar(160)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  users         AppUser[]

  @@unique([institutionId, code])
  @@unique([institutionId, id])
}

enum CampusRole {
  estudiante
  docente
  ti_agente
  ti_supervisor
  administrador
}

model RoleAccess {
  institutionId String @db.Uuid
  role          CampusRole
  permissions   String[]
  version       Int @default(1)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@id([institutionId, role])
}

model RolePermissionChange {
  id            String @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  role          CampusRole
  actorId       String @db.Uuid
  reason        String @db.VarChar(500)
  before        Json
  after         Json
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([institutionId, createdAt])
}

model AppUser {
  // UUID canÃ³nico = subject de Supabase. Las credenciales permanecen en Auth.
  id            String @id @db.Uuid
  institutionId String @db.Uuid
  email         String @db.VarChar(254)
  displayName   String @db.VarChar(120)
  role          CampusRole @default(estudiante)
  active        Boolean @default(true)
  teamId        String? @db.Uuid
  accessVersion Int @default(1)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  team          SupportTeam? @relation(fields: [institutionId, teamId], references: [institutionId, id], onDelete: Restrict)
  sessions      AuthSession[]
  tickets       Ticket[]

  @@unique([institutionId, id])
  @@index([institutionId, role, active])
}

model AuthSession {
  // Solo la huella de la cookie opaca; tokens cifrados con AES-256-GCM.
  id            String @id @db.VarChar(64)
  instanceId    String @default("legacy") @db.VarChar(64)
  userId        String @db.Uuid
  accessVersion Int
  tokens        String @db.Text
  tokenExpiresAt DateTime @db.Timestamptz(3)
  expiresAt     DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  user          AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([instanceId, expiresAt])
}

model AuthThrottle {
  id        String @id @db.VarChar(64)
  attempts  Int @default(1)
  expiresAt DateTime @db.Timestamptz(3)
}

model AuthFlow {
  id        String @id @db.VarChar(64)
  instanceId String @default("legacy") @db.VarChar(64)
  purpose   String @db.VarChar(20)
  secret    String @db.Text
  expiresAt DateTime @db.Timestamptz(3)
  @@index([instanceId, expiresAt])
}

// Cambios de autorizaciÃ³n atÃ³micos para entrega futura a auditorÃ­a de Jasmine.
model IdentityChange {
  id            String @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  actorId       String @db.Uuid
  subjectId     String @db.Uuid
  reason        String @db.VarChar(500)
  before        Json
  after         Json
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  @@index([institutionId, createdAt])
}

// Identificadores iniciales aislados en incidencias. Si Roberto publica un
// catÃ¡logo canÃ³nico, sustituir esta fuente mediante una migraciÃ³n coordinada.
enum TicketService {
  aula_virtual
  wifi_red
  correo
  equipos
  impresoras
  cuentas_accesos
  videoconferencia
  sistemas_institucionales
  almacenamiento_nube
  software_licencias
  otro
}

enum TicketScope {
  general
  curso
}

enum TicketStatus {
  registrado
  en_atencion
  resuelto
}

enum TicketClassificationStatus {
  pendiente
  manual
}

model Ticket {
  id                   String                     @id @default(uuid()) @db.Uuid
  institutionId        String                     @db.Uuid
  ownerId              String                     @db.Uuid
  code                 String                     @unique @db.VarChar(40)
  description          String                     @db.Text
  service              TicketService
  scope                TicketScope
  // SQL futuro: general => ambos nulos; curso => courseId obligatorio.
  // NestJS comprueba la asociaciÃ³n del titular; las FK no la acreditan.
  courseId             String?                    @db.Uuid
  sectionId            String?                    @db.Uuid
  status               TicketStatus               @default(registrado)
  classificationStatus TicketClassificationStatus @default(pendiente)
  idempotencyKey       String                     @db.Uuid
  requestHash          String                     @db.Char(64)
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(3)
  owner                AppUser                    @relation(fields: [institutionId, ownerId], references: [institutionId, id], onDelete: Restrict)
  course               AcademicCourse?            @relation(fields: [institutionId, courseId], references: [institutionId, id], onDelete: Restrict)
  section              AcademicSection?           @relation(fields: [institutionId, courseId, sectionId], references: [institutionId, courseId, id], onDelete: Restrict)
  version              Int @default(1)
  urgency              Int?
  impact               Int?
  academicFactor       Float?
  academicContext      Json?
  technicalScore       Int?
  score                Float?
  priority             String? @db.VarChar(2)
  policyVersion        Int?
  responseDueAt        DateTime? @db.Timestamptz(3)
  resolutionDueAt      DateTime? @db.Timestamptz(3)
  firstResponseAt      DateTime? @db.Timestamptz(3)
  resolvedAt           DateTime? @db.Timestamptz(3)
  assigneeId           String? @db.Uuid
  solution             String? @db.Text
  failureConfirmed     Boolean @default(false)
  isDemo               Boolean @default(false)
  changes              TicketChange[]
  attachment           TicketAttachment?

  @@unique([institutionId, ownerId, idempotencyKey])
  @@index([institutionId, ownerId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([institutionId, ownerId, status, createdAt(sort: Desc), id(sort: Desc)])
}

// Metadatos opcionales; carga y descarga aÃºn pendientes de contrato con Roberto.
// SQL futuro: tamaÃ±o positivo, MIME PNG/JPG/PDF, SHA-256 hexadecimal y
// storageKey opaca sin componentes de ruta. RLS para esta tabla y Ticket.
// Los bytes privados locales nunca se guardan en PostgreSQL ni se comparten
// automÃ¡ticamente entre computadoras.
model TicketAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @unique @db.Uuid
  storageKey   String   @unique @db.VarChar(120)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(40)
  sizeBytes    Int
  sha256       String   @db.Char(64)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
}

model TicketChange {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  institutionId String @db.Uuid
  actorId String @db.Uuid
  action String @db.VarChar(40)
  note String @db.VarChar(2000)
  before Json?
  after Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  @@index([institutionId, ticketId, createdAt])
}
model WorkflowPolicy {
  institutionId String @id @db.Uuid
  rules Json
  version Int @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
