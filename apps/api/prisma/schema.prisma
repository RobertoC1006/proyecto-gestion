generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Base de instalación; identidad y tickets se coordinan antes de añadir sus tablas.
model Institution {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @unique @db.VarChar(40)
  name      String        @db.VarChar(160)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  teams     SupportTeam[]
}

model SupportTeam {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @db.Uuid
  code          String      @db.VarChar(40)
  name          String      @db.VarChar(160)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([institutionId, code])
}
